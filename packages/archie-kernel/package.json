{
  "name": "@beamstudio/archie-kernel",
  "version": "1.0.0",
  "private": true,
  "description": "The Runtime OS and central coordinator for Archie",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@beamstudio/context-engine": "workspace:*",
    "@beamstudio/tool-registry": "workspace:*",
    "@beamstudio/utils": "workspace:*",
    "@beamstudio/planning-engine": "workspace:*",
    "@beamstudio/execution-graph": "workspace:*",
    "@beamstudio/task-scheduler": "workspace:*",
    "@beamstudio/knowledge-platform": "workspace:*",
    "@beamstudio/policy-engine": "workspace:*",
    "@beamstudio/resource-manager": "workspace:*",
    "@beamstudio/memory-system": "workspace:*",
    "@beamstudio/solver-runtime": "workspace:*",
    "@beamstudio/engineering-reasoning": "workspace:*",
    "@beamstudio/agent-framework": "workspace:*",
    "@beamstudio/agent-design": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.0.2",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1",
    "rimraf": "^5.0.5"
  }
}
