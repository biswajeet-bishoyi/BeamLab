{
  "name": "@beamlab/bridge-engine",
  "version": "0.1.0",
  "description": "Bridge Engineering & Moving Live Load Analysis Engine: Vehicular Catalog (AASHTO, Eurocode, IRC), Müller-Breslau Influence Lines, Moving Load Stepping, Girder Distribution Factors, and Dynamic Impact",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beamlab/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
