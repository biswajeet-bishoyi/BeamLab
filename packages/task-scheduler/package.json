{
  "name": "@beamlab/task-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Task Scheduler for Archie Kernel",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@beamlab/execution-graph": "workspace:*",
    "@beamlab/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.0.2",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1",
    "rimraf": "^5.0.5"
  }
}
