{
  "name": "@beamstudio/agent-structural-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "BeamLab Structural Analysis Engineering Agent",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@beamstudio/agent-framework": "workspace:*",
    "@beamstudio/memory-client": "workspace:*",
    "@beamstudio/workspace-runtime": "workspace:*",
    "@beamstudio/knowledge-platform": "workspace:*",
    "@beamstudio/policy-engine": "workspace:*",
    "@beamstudio/resource-manager": "workspace:*",
    "@beamstudio/solver-client": "workspace:*",
    "@beamstudio/engineering-reasoning": "workspace:*"
  },
  "devDependencies": {
    "@beamstudio/config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
