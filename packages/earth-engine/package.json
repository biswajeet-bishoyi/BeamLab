{
  "name": "@beamstudio/earth-engine",
  "version": "0.1.0",
  "description": "Earth Retaining Structures & Deep Excavation Engine: Rankine/Coulomb Lateral Pressures, Retaining Wall Stability, Anchored Sheet Piles, and Bishop Slope Stability",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
